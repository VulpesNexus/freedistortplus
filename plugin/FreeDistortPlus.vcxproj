<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{8E2D51C7-3A44-4F0B-9C61-5D7B2E90A3F4}</ProjectGuid>
    <RootNamespace>FreeDistortPlus</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <!-- Where the Adobe Illustrator SDK lives. Set the AI_SDK_ROOT environment
       variable, or pass /p:AISDKRoot=... on the command line. The SDK is not
       redistributable, so it is never vendored here and no default path is
       baked in. -->
  <PropertyGroup Label="SDKLocation">
    <AISDKRoot Condition="'$(AISDKRoot)' == '' and '$(AI_SDK_ROOT)' != ''">$(AI_SDK_ROOT)</AISDKRoot>
    <AISDKApi>$(AISDKRoot)\illustratorapi</AISDKApi>
    <AISDKCommon>$(AISDKRoot)\samplecode\common</AISDKCommon>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseOfMfc>false</UseOfMfc>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <OutDir>$(MSBuildProjectDirectory)\..\build\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\..\build\obj\$(Configuration)\</IntDir>
    <TargetName>FreeDistortPlus</TargetName>
    <TargetExt>.aip</TargetExt>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory)\Source;$(MSBuildProjectDirectory)\Resources\Win;$(AISDKCommon)\includes;$(AISDKApi)\ate;$(AISDKApi)\illustrator;$(AISDKApi)\illustrator\actions;$(AISDKApi)\pica_sp;$(AISDKApi)\illustrator\legacy;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_WINDOWS;WIN_ENV;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary Condition="'$(Configuration)' == 'Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)' == 'Release'">MultiThreadedDLL</RuntimeLibrary>
      <StructMemberAlignment>8Bytes</StructMemberAlignment>
      <TreatWChar_tAsBuiltInType>false</TreatWChar_tAsBuiltInType>
      <RuntimeTypeInfo>true</RuntimeTypeInfo>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalOptions>/Zc:sizedDealloc- /utf-8 %(AdditionalOptions)</AdditionalOptions>
      <WarningLevel>Level4</WarningLevel>
      <!-- 4819 and 4828: the Adobe SDK headers are not UTF-8, and /utf-8 makes
           the compiler say so once per header per translation unit. Neither
           can fire on this project's own sources, which are ASCII. -->
      <DisableSpecificWarnings>4819;4828;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <CompileAs>CompileAsCpp</CompileAs>
      <ForcedIncludeFiles>pragma.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <Optimization Condition="'$(Configuration)' == 'Debug'">Disabled</Optimization>
      <Optimization Condition="'$(Configuration)' == 'Release'">MaxSpeed</Optimization>
    </ClCompile>
    <ResourceCompile>
      <Culture>0x0409</Culture>
      <AdditionalIncludeDirectories>$(MSBuildProjectDirectory);$(MSBuildProjectDirectory)\Source;$(MSBuildProjectDirectory)\Resources\Win;$(MSBuildProjectDirectory)\Resources\raw;$(AISDKCommon)\win;$(AISDKCommon)\includes;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <ModuleDefinitionFile>$(AISDKCommon)\win\PluginMain.def</ModuleDefinitionFile>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <!-- Without this the linker stamps the full path of the build machine's
           .pdb into the shipped binary. -->
      <AdditionalOptions>/PDBALTPATH:$(TargetName).pdb %(AdditionalOptions)</AdditionalOptions>
      <RandomizedBaseAddress>true</RandomizedBaseAddress>
      <TargetMachine>MachineX64</TargetMachine>
      <LargeAddressAware>true</LargeAddressAware>
      <AdditionalDependencies>comctl32.lib;user32.lib;gdi32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PreBuildEvent>
      <Command>python "$(AISDKRoot)\tools\pipl\create_pipl.py" -input "[{\"name\":\"FreeDistortPlus\",\"entry_point\":\"PluginMain\"}]"</Command>
      <Message>Generating plugin.pipl</Message>
    </PreBuildEvent>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="Source\FDPPlugin.cpp" />
    <ClCompile Include="Source\FDPSuites.cpp" />
    <ClCompile Include="Source\FreeDistortEffect.cpp" />
    <ClCompile Include="Source\DistortEditor.cpp" />
    <ClCompile Include="Source\Introspect.cpp" />
    <ClCompile Include="Source\FDPAbout.cpp" />
    <ClCompile Include="Source\FDPTheme.cpp" />
    <ClCompile Include="Source\CornerDialog.cpp" />
    <ClCompile Include="$(AISDKApi)\illustrator\IAIUnicodeString.cpp" />
    <ClCompile Include="$(AISDKCommon)\source\Main.cpp" />
    <ClCompile Include="$(AISDKCommon)\source\Plugin.cpp" />
    <ClCompile Include="$(AISDKCommon)\source\Suites.cpp" />
    <ClCompile Include="$(AISDKCommon)\source\AppContext.cpp" />
    <ClCompile Include="$(AISDKCommon)\source\SDKErrors.cpp" />
    <ClCompile Include="$(AISDKCommon)\source\SDKAboutPluginsHelper.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="Source\FDPPlugin.h" />
    <ClInclude Include="Source\FDPSuites.h" />
    <ClInclude Include="Source\FDPID.h" />
    <ClInclude Include="Source\FreeDistortEffect.h" />
    <ClInclude Include="Source\DistortEditor.h" />
    <ClInclude Include="Source\QuadMath.h" />
    <ClInclude Include="Source\Introspect.h" />
    <ClInclude Include="Source\FDPAbout.h" />
    <ClInclude Include="Source\FDPTheme.h" />
    <ClInclude Include="Source\CornerDialog.h" />
    <ClInclude Include="Source\DialogPlacement.h" />
  </ItemGroup>

  <ItemGroup>
    <ResourceCompile Include="Resources\Win\FreeDistortPlus.rc" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
