#include <winres.h>
#include "Resource.h"
#include "FreeDistortPlusAbout.rc"

// SysLink needs version 6 of the common controls. The plugin inherits that
// from Illustrator's activation context; a bare executable has to ask for it.
1 RT_MANIFEST "harness.manifest"
